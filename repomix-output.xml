}

function KeyboardStandalone({ passion }: StandaloneModelProps) {
  const reduced = useReducedMotion();
  const ref = useRef<THREE.Group | null>(null);
  const emissive = useMemo(() => makeEmissive(passion), [passion]);
  const bodyColor = useMemo(() => new THREE.Color('#16161c'), []);
  const keyColor = useMemo(() => new THREE.Color('#e8e8ea'), []);

  const keys = useMemo(() => {
    const out: { x: number; y: number }[] = [];
    const rows = 4;
    const cols = 7;
    const startX = -0.7;
    const startY = -0.18;
    const spacingX = 1.4 / (cols - 1);
    const spacingY = 0.36 / (rows - 1);
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        out.push({ x: startX + c * spacingX, y: startY + r * spacingY });
      }
    }
    return out;
  }, []);

  useFrame((state, delta) => {
    if (!ref.current || reduced) return;
    ref.current.rotation.y += delta * 0.2;
  });

  return (
    <group ref={ref}>
      <Float speed={1.2} rotationIntensity={0.18} floatIntensity={0.35}>
        <RoundedBox args={[1.6, 0.6, 0.16]} radius={0.05} smoothness={4} position={[0, 0, 0]}>
          <meshStandardMaterial color={bodyColor} roughness={0.55} metalness={0.2} />
        </RoundedBox>
        {keys.map((k, i) => (
          <RoundedBox key={`key-${i}`} args={[0.14, 0.12, 0.05]} radius={0.012} smoothness={3} position={[k.x, k.y, 0.1]}>
            <meshStandardMaterial color={keyColor} roughness={0.5} metalness={0.05} emissive={emissive} emissiveIntensity={0.05} />
          </RoundedBox>
        ))}
        {[
          { x: -0.55, y: 0.32 },
          { x: -0.35, y: 0.32 },
          { x: 0.35, y: 0.32 },
          { x: 0.55, y: 0.32 },
        ].map((knob, i) => (
          <group key={`knob-${i}`} position={[knob.x, knob.y, 0.1]}>
            <mesh>
              <cylinderGeometry args={[0.05, 0.05, 0.08, 24]} />
              <meshStandardMaterial color={bodyColor} roughness={0.4} metalness={0.7} emissive={emissive} emissiveIntensity={0.1} toneMapped={false} />
            </mesh>
            <mesh position={[0, 0.05, 0]}>
              <cylinderGeometry args={[0.06, 0.06, 0.02, 24]} />
              <meshStandardMaterial color="#ff5555" emissive="#ff3333" emissiveIntensity={0.6} toneMapped={false} />
            </mesh>
          </group>
        ))}
        <pointLight position={[0, 0.3, 1]} color={emissive} intensity={0.65} distance={2.2} />
      </Float>
    </group>
  );
}

export const STANDALONE_MODELS = {
  cooking: ChefHatStandalone,
  gaming: GamepadStandalone,
  music: KeyboardStandalone,
} as const;

interface FrameloopSceneProps {
  passion: ProfilePassion;
}

export function FrameloopScene({ passion }: FrameloopSceneProps) {
  const Model = STANDALONE_MODELS[passion];
  const meta = PASSION_META[passion];
  return (
    <>
      <ambientLight intensity={0.5} />
      <directionalLight position={[3, 3, 3]} intensity={0.8} />
      <pointLight
        position={[0, 0.5, 1.5]}
        color={`hsl(${meta.lightColor.h}, ${meta.lightColor.s}%, ${meta.lightColor.l}%)`}
        intensity={1.4}
        distance={5}
      />
      <Model passion={passion} />
    </>
  );
}
