/* ─── Section (pinned, full viewport) ─── */

.section {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  background: hsl(var(--background) / 0.4);
}

/* ─── Header (fixed at top while pinned) ─── */

.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  padding: 40px 5vw 0;
  text-align: center;
  pointer-events: none;
}

.headerLabel {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  color: hsl(var(--muted-foreground));
}

.headerLine {
  display: inline-block;
  width: 48px;
  height: 1px;
  background: linear-gradient(to right, hsl(var(--primary)), transparent);
}

.heading {
  margin: 12px 0 0;
  font-size: clamp(2rem, 5vw, 4rem);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1;
}

.headingBefore {
  background: linear-gradient(135deg, hsl(var(--foreground)), hsl(var(--muted-foreground)));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.headingAfter {
  background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.progress {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 14px;
  padding: 6px 14px;
  border-radius: 9999px;
  background: hsl(var(--background) / 0.6);
  backdrop-filter: blur(12px);
  border: 1px solid hsl(var(--border) / 0.5);
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.75rem;
  font-weight: 500;
  color: hsl(var(--muted-foreground));
}

/* ─── Track area (below header, full width) ─── */

.trackArea {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-top: 110px;
  padding-bottom: 32px;
  pointer-events: none;
}

.track {
  position: relative;
  display: flex;
  align-items: center;
  gap: 100px;
  padding: 0 25vw 0 15vw;
  height: 600px;
  will-change: transform;
  perspective: 1000px;
  pointer-events: none;
}

/* Items group: contains the 9 cards + the axis line. The 60px
   horizontal padding extends the axis line 60px past the first
   and last items, so the line reaches further toward the title
   and CTA while the cards themselves stay aligned. */
.itemsGroup {
  position: relative;
  display: flex;
  align-items: center;
  gap: 60px;
  padding: 0 60px;
  flex-shrink: 0;
}

/* ─── Axis line (subtle white horizontal, spans itemsGroup) ─── */

.axis {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent 0%, hsl(0 0% 100% / 0.18) 3%, hsl(0 0% 100% / 0.22) 50%, hsl(0 0% 100% / 0.18) 97%, transparent 100%);
  transform: translateY(-50%);
  z-index: 1;
  pointer-events: none;
}

/* ─── Item wrapper (zigzag, fixed 560px tall) ─── */

.itemWrapper {
  position: relative;
  width: 380px;
  height: 600px;
  display: grid;
  grid-template-rows: 1fr 1fr;
  flex-shrink: 0;
  z-index: 2;
}

.connectorDot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  background: white;
  border-radius: 50%;
  border: 2px solid hsl(var(--background));
  z-index: 3;
  box-shadow: 0 0 0 4px hsl(var(--background) / 0.6);
}

.connectorDot[data-latest="true"] {
  background: hsl(var(--primary));
  box-shadow: 0 0 0 4px hsl(var(--background) / 0.6), 0 0 16px hsl(var(--primary) / 0.6);
}

.itemContent {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.itemWrapper[data-position="top"] .itemContent {
  grid-row: 1;
  justify-content: flex-end;
  padding-bottom: 36px;
}

.itemWrapper[data-position="bottom"] .itemContent {
  grid-row: 2;
  justify-content: flex-start;
  padding-top: 36px;
}

.cardSlot {
  pointer-events: auto;
  width: 100%;
  display: flex;
}

.connectorLine {
  width: 1px;
  height: 36px;
  background: linear-gradient(to bottom, hsl(var(--primary) / 0.6), hsl(var(--primary) / 0.1));
  flex-shrink: 0;
}

/* ─── Cards (base) ─── */

.card {
  width: 100%;
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  border-radius: 1rem;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  border-color: hsl(var(--primary) / 0.4);
}

.cardMilestone {
  background: hsl(230 30% 12% / 0.6);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border: 1px solid hsl(0 0% 100% / 0.12);
  padding: 18px;
  gap: 4px;
  height: 200px;
}

.cardExperience {
  background: hsl(230 30% 12% / 0.6);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border: 1px solid hsl(0 0% 100% / 0.12);
  padding: 20px;
  gap: 8px;
  height: 260px;
}

.cardCta {
  background: hsl(230 30% 12% / 0.6);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border: 1px solid hsl(0 0% 100% / 0.12);
  padding: 32px 32px;
  gap: 12px;
  align-items: center;
  justify-content: center;
  text-align: center;
  text-decoration: none;
  color: inherit;
  width: 440px;
  flex-shrink: 0;
  height: 260px;
  box-shadow: 0 0 40px hsl(var(--primary) / 0.1);
}

.cardCta:hover {
  border-color: hsl(var(--primary) / 0.5);
  box-shadow: 0 0 50px hsl(var(--primary) / 0.3);
}

/* ─── Card internals ─── */

.cardTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}

.cardDate {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: hsl(var(--muted-foreground));
  white-space: nowrap;
}

.cardTitle {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.2;
  color: hsl(var(--foreground));
}

.cardOrg {
  margin: 0;
  font-size: 0.82rem;
  font-weight: 500;
  color: hsl(var(--primary));
}

.cardLocation {
  margin: 0;
  font-size: 0.7rem;
  color: hsl(var(--muted-foreground));
  line-height: 1.4;
}

.cardModality {
  color: hsl(var(--muted-foreground) / 0.8);
}

.cardDetail {
  margin-top: 4px;
  font-size: 0.78rem;
  line-height: 1.45;
  color: hsl(var(--foreground) / 0.85);
}

.cardBullets {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.cardBullet {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.75rem;
  line-height: 1.4;
  color: hsl(var(--foreground) / 0.85);
}

.bulletDot {
  display: inline-block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: hsl(var(--primary));
  margin-top: 6px;
  flex-shrink: 0;
}

.techTags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px solid hsl(0 0% 100% / 0.08);
}

.techTag {
  display: inline-block;
  padding: 2px 9px;
  border-radius: 9999px;
  border: 1px solid hsl(0 0% 100% / 0.1);
  background: hsl(0 0% 100% / 0.04);
  font-size: 0.66rem;
  color: hsl(var(--foreground) / 0.9);
}

/* ─── Title card (start of track, single-line) ─── */

.titleCard {
  display: inline-flex;
  align-items: baseline;
  flex-shrink: 0;
  padding: 0 12px;
  pointer-events: none;
  white-space: nowrap;
}

.titleMi {
  font-size: clamp(1.4rem, 2.8vw, 2.2rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: hsl(var(--foreground));
  opacity: 0.85;
  margin-right: 0.5em;
  line-height: 1;
}

.titleTrayectoria {
  font-size: clamp(2.6rem, 5.2vw, 4.2rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  color: hsl(var(--primary));
  line-height: 0.95;
}

/* ─── CTA card internals ─── */

.ctaTitle {
  font-size: 1.2rem;
  font-weight: 600;
  color: hsl(var(--foreground));
}

.ctaSubtitle {
  font-size: 0.82rem;
  color: hsl(var(--muted-foreground));
  line-height: 1.4;
  max-width: 280px;
}

/* ─── Mobile (vertical stack) ─── */

.mobileSection {
  position: relative;
  padding: 64px 20px 96px;
  background: hsl(var(--background) / 0.4);
}

.mobileHeader {
  margin-bottom: 40px;
  text-align: left;
}

.mobileTimeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding-left: 28px;
}

.mobileLine {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 11px;
  width: 2px;
  background: linear-gradient(to bottom, hsl(var(--primary) / 0.6), hsl(var(--primary) / 0.1));
}

.mobileItem {
  position: relative;
  display: flex;
  flex-direction: column;
}

.mobileDot {
  position: absolute;
  top: 20px;
  left: -22px;
  width: 12px;
  height: 12px;
  background: white;
  border-radius: 50%;
  border: 2px solid hsl(var(--background));
  z-index: 2;
}

.mobileCardWrap {
  width: 100%;
}

.mobileCardWrap .cardMilestone,
