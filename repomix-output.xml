import { useState } from 'react';
import { useFrame } from '@react-three/fiber';
import { useScroll, Html } from '@react-three/drei';
import { useLanguage } from '@/context/LanguageContext';
import { PROFILE_PASSIONS, PASSION_META, type ProfilePassion } from '@/lib/profile-content';

export function ProfileText() {
  const scroll = useScroll();
  const { t } = useLanguage();
  const [active, setActive] = useState<ProfilePassion>(PROFILE_PASSIONS[0]);

  useFrame(() => {
    const t = scroll.offset;
    let nearest = PROFILE_PASSIONS[0];
    let minDist = Infinity;
    PROFILE_PASSIONS.forEach((k) => {
      const d = Math.abs(PASSION_META[k].scrollPhase - t);
      if (d < minDist) {
        minDist = d;
        nearest = k;
      }
    });
    if (nearest !== active) setActive(nearest);
  });

  return (
    <Html
      position={[0, 0, 0]}
      center
      transform={false}
      style={{ pointerEvents: 'none', width: '100%', height: '100%' }}
      zIndexRange={[10, 0]}
    >
      <div className="profile-text-overlay" aria-live="polite">
        {PROFILE_PASSIONS.map((key) => {
          const meta = PASSION_META[key];
          const isActive = key === active;
          return (
            <article
              key={key}
              className={`profile-text-card ${isActive ? 'is-active' : ''}`}
              aria-hidden={!isActive}
              data-passion={key}
            >
              <span className="profile-text-label">{t(`profile.passion.${key}.label`)}</span>
              <h2 className="profile-text-title">{t(`profile.passion.${key}.title`)}</h2>
              <p className="profile-text-body">{t(`profile.passion.${key}.body`)}</p>
            </article>
          );
        })}
      </div>
    </Html>
  );
}
