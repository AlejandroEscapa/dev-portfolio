import { useRef, useMemo, useEffect } from 'react';
import { useFrame } from '@react-three/fiber';
import { Float, RoundedBox } from '@react-three/drei';
import * as THREE from 'three';
import { useReducedMotion } from '@/hooks/useReducedMotion';
import { PASSION_META, type ProfilePassion } from '@/lib/profile-content';

interface StandaloneModelProps {
  passion: ProfilePassion;
}

function makeEmissive(passion: ProfilePassion) {
  const m = PASSION_META[passion].emissiveColor;
  return new THREE.Color(`hsl(${m.h}, ${m.s}%, ${m.l}%)`);
}

function ChefHatStandalone({ passion }: StandaloneModelProps) {
  const reduced = useReducedMotion();
  const ref = useRef<THREE.Group | null>(null);
  const emissive = useMemo(() => makeEmissive(passion), [passion]);
  const baseColor = useMemo(() => new THREE.Color('#fafafa'), []);

  useFrame((state, delta) => {
    if (!ref.current || reduced) return;
    ref.current.rotation.y += delta * 0.18;
  });

  return (
    <group ref={ref}>
      <Float speed={1.1} rotationIntensity={0.15} floatIntensity={0.3}>
        <mesh position={[0, -0.55, 0]}>
          <cylinderGeometry args={[0.55, 0.6, 0.18, 32]} />
          <meshStandardMaterial color={baseColor} roughness={0.55} metalness={0.05} emissive={emissive} emissiveIntensity={0.08} />
        </mesh>
        <mesh position={[0, 0.15, 0]}>
          <cylinderGeometry args={[0.5, 0.55, 1.05, 32]} />
          <meshStandardMaterial color={baseColor} roughness={0.5} metalness={0.05} emissive={emissive} emissiveIntensity={0.1} />
        </mesh>
        <mesh position={[0, 0.6, 0]}>
          <sphereGeometry args={[0.4, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissive} emissiveIntensity={0.06} />
        </mesh>
        <mesh position={[0, 0.78, 0]}>
          <sphereGeometry args={[0.36, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissive} emissiveIntensity={0.06} />
        </mesh>
        <mesh position={[0, 0.92, 0]}>
          <sphereGeometry args={[0.3, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissive} emissiveIntensity={0.06} />
        </mesh>
        <pointLight position={[0, 0.5, 0.8]} color={emissive} intensity={0.6} distance={2} />
      </Float>
    </group>
  );
}

function GamepadStandalone({ passion }: StandaloneModelProps) {
  const reduced = useReducedMotion();
  const ref = useRef<THREE.Group | null>(null);
  const emissive = useMemo(() => makeEmissive(passion), [passion]);
  const bodyColor = useMemo(() => new THREE.Color('#1a1a1f'), []);
  const accentColor = useMemo(() => new THREE.Color('#2a2a32'), []);

  useFrame((state, delta) => {
    if (!ref.current || reduced) return;
    ref.current.rotation.y += delta * 0.25;
  });

  return (
    <group ref={ref}>
      <Float speed={1.3} rotationIntensity={0.2} floatIntensity={0.4}>
        <RoundedBox args={[1.6, 0.45, 0.7]} radius={0.18} smoothness={6} position={[0, 0, 0]}>
          <meshStandardMaterial color={bodyColor} roughness={0.35} metalness={0.4} emissive={emissive} emissiveIntensity={0.15} toneMapped={false} />
        </RoundedBox>
        {[
          { x: -0.55, y: -0.05 },
          { x: 0.55, y: -0.05 },
        ].map((s, i) => (
          <mesh key={i} position={[s.x, s.y, 0.36]}>
            <cylinderGeometry args={[0.13, 0.13, 0.1, 24]} />
            <meshStandardMaterial color={accentColor} roughness={0.4} metalness={0.5} emissive={emissive} emissiveIntensity={0.2} toneMapped={false} />
          </mesh>
        ))}
        {[
          { x: 0.55, y: 0, z: 0.15 },
          { x: 0.7, y: 0.15, z: 0.15 },
          { x: 0.7, y: -0.15, z: 0.15 },
          { x: 0.85, y: 0, z: 0.15 },
        ].map((p, i) => (
          <mesh key={`key-${i}`} position={[p.x, p.y, p.z]}>
            <cylinderGeometry args={[0.06, 0.06, 0.04, 16]} />
            <meshStandardMaterial color="#e0e0e0" roughness={0.3} metalness={0.6} emissive={emissive} emissiveIntensity={0.1} toneMapped={false} />
          </mesh>
        ))}
        {[
          { x: -0.3, y: 0.12, w: 0.18, h: 0.07 },
          { x: -0.15, y: 0.12, w: 0.18, h: 0.07 },
          { x: -0.225, y: 0.19, w: 0.07, h: 0.18 },
          { x: -0.225, y: 0.05, w: 0.07, h: 0.18 },
        ].map((p, i) => (
          <mesh key={`dpad-${i}`} position={[p.x, p.y, 0.36]}>
            <boxGeometry args={[p.w, p.h, 0.05]} />
            <meshStandardMaterial color={accentColor} roughness={0.45} metalness={0.3} />
          </mesh>
        ))}
        <pointLight position={[0, 0, 1]} color={emissive} intensity={0.7} distance={2.5} />
