<file path="src/index.css">
@import "tailwindcss";

.hero-showcase {
  padding-top: var(--hero-pad-top, 32px);
}

/* === App-wide layout tokens (single source of truth) === */
/* Registered via Tailwind v4's @utility so its variants (`lg:`,
   `max-lg:`, etc.) are auto-generated. Without this directive,
   Tailwind only emits `viewport-content` — `lg:viewport-content`
   would silently do nothing and arbitrary-value utilities like
   `h-[55vh]` would still win the cascade at the same breakpoint.
   Change `--nav-height` in :root to retune top-folding heights. */
@utility viewport-content {
  height: calc(100vh - var(--nav-height, 60px));
}

/* === Terminal Portfolio Design System — Tailwind v4 === */

:root {
  --background: hsl(230 35% 5%);
  --foreground: hsl(210 40% 98%);

  --card: hsl(230 30% 8%);
  --card-foreground: hsl(210 40% 98%);

  --popover: hsl(230 35% 7%);
  --popover-foreground: hsl(210 40% 98%);

  --primary: hsl(248 90% 66%);
  --primary-foreground: hsl(0 0% 100%);
  --primary-glow: hsl(270 95% 75%);

  --secondary: hsl(230 25% 14%);
  --secondary-foreground: hsl(210 40% 98%);

  --muted: hsl(230 20% 14%);
  --muted-foreground: hsl(230 15% 65%);

  --accent: hsl(190 95% 60%);
  --accent-foreground: hsl(230 35% 5%);

  --destructive: hsl(0 84% 60%);
  --destructive-foreground: hsl(210 40% 98%);

  --border: hsl(230 25% 18%);
  --input: hsl(230 25% 14%);
  --ring: hsl(248 90% 66%);

  --radius: 1rem;

  /* Layout tokens — single source of truth for app-wide measurements.
     Change HERE to affect every section / window at once. */
  --nav-height: 60px;       /* matches Nav.tsx scroll offset (const navHeight = 60) */
  --hero-pad-top: 32px;     /* HeroShowcase top breathing room. Sized as
                                1/4 of `<main>`'s pb-32 (128px) and equal
                                to the right column's gap-8, so the section
                                feels proportional to the rest of the page.
                                The sticky LEFT col stops at this offset
                                (see HeroShowcase.tsx) — the gap stays
                                visible while scrolling through
                                HeroShowcase, then unpins near #profile. */


  --sidebar-background: hsl(230 35% 5%);
  --sidebar-foreground: hsl(210 40% 98%);
  --sidebar-primary: hsl(248 90% 66%);
  --sidebar-primary-foreground: hsl(0 0% 100%);
  --sidebar-accent: hsl(230 25% 14%);
  --sidebar-accent-foreground: hsl(210 40% 98%);
  --sidebar-border: hsl(230 25% 18%);
  --sidebar-ring: hsl(248 90% 66%);

  --mesh-1: hsl(248 90% 66%);
  --mesh-2: hsl(190 95% 60%);
  --mesh-3: hsl(320 85% 65%);
  --mesh-4: hsl(270 95% 75%);

  --shadow-glow: 0 0 60px hsl(248 90% 66% / 0.45);
  --shadow-glow-accent: 0 0 60px hsl(190 95% 60% / 0.4);
  --shadow-elegant: 0 25px 60px -20px hsl(248 90% 66% / 0.35);
  --shadow-glass: 0 8px 32px hsl(230 50% 2% / 0.5);
}

/* === Theme overrides via data-theme === */
[data-theme="catppuccin"] {
  --background: hsl(290 20% 12%);
  --foreground: hsl(80 20% 90%);
  --card: hsl(290 20% 15%);
  --card-foreground: hsl(80 20% 90%);
  --popover: hsl(290 20% 13%);
  --popover-foreground: hsl(80 20% 90%);
  --primary: hsl(200 60% 65%);
  --primary-foreground: hsl(290 20% 12%);
  --primary-glow: hsl(195 50% 72%);
  --secondary: hsl(290 15% 18%);
  --secondary-foreground: hsl(80 20% 90%);
  --muted: hsl(290 15% 18%);
  --muted-foreground: hsl(290 10% 55%);
  --accent: hsl(320 65% 72%);
  --accent-foreground: hsl(290 20% 12%);
  --border: hsl(290 15% 22%);
  --input: hsl(290 15% 18%);
  --ring: hsl(200 60% 65%);
  --mesh-1: hsl(200 60% 65%);
  --mesh-2: hsl(320 65% 72%);
  --mesh-3: hsl(160 55% 60%);
  --mesh-4: hsl(195 50% 72%);
  --shadow-glow: 0 0 60px hsl(200 60% 65% / 0.45);
  --shadow-glow-accent: 0 0 60px hsl(320 65% 72% / 0.4);
}

[data-theme="dracula"] {
  --background: hsl(290 15% 15%);
  --foreground: hsl(290 10% 92%);
  --card: hsl(290 15% 18%);
  --card-foreground: hsl(290 10% 92%);
  --popover: hsl(290 15% 16%);
  --popover-foreground: hsl(290 10% 92%);
  --primary: hsl(340 70% 65%);
  --primary-foreground: hsl(290 15% 12%);
  --primary-glow: hsl(340 60% 72%);
  --secondary: hsl(290 12% 20%);
  --secondary-foreground: hsl(290 10% 92%);
  --muted: hsl(290 12% 20%);
  --muted-foreground: hsl(290 8% 55%);
  --accent: hsl(140 55% 60%);
  --accent-foreground: hsl(290 15% 12%);
  --border: hsl(290 12% 25%);
  --input: hsl(290 12% 20%);
  --ring: hsl(340 70% 65%);
  --mesh-1: hsl(340 70% 65%);
  --mesh-2: hsl(140 55% 60%);
  --mesh-3: hsl(280 55% 60%);
  --mesh-4: hsl(340 60% 72%);
  --shadow-glow: 0 0 60px hsl(340 70% 65% / 0.45);
  --shadow-glow-accent: 0 0 60px hsl(140 55% 60% / 0.4);
}

[data-theme="tokyo-night"] {
  --background: hsl(260 25% 12%);
  --foreground: hsl(240 15% 88%);
  --card: hsl(260 25% 15%);
  --card-foreground: hsl(240 15% 88%);
  --popover: hsl(260 25% 13%);
  --popover-foreground: hsl(240 15% 88%);
  --primary: hsl(230 60% 60%);
  --primary-foreground: hsl(260 25% 12%);
  --primary-glow: hsl(200 55% 68%);
  --secondary: hsl(260 18% 18%);
  --secondary-foreground: hsl(240 15% 88%);
  --muted: hsl(260 18% 18%);
  --muted-foreground: hsl(260 10% 55%);
  --accent: hsl(320 60% 68%);
  --accent-foreground: hsl(260 25% 12%);
  --border: hsl(260 18% 22%);
  --input: hsl(260 18% 18%);
  --ring: hsl(230 60% 60%);
  --mesh-1: hsl(230 60% 60%);
  --mesh-2: hsl(320 60% 68%);
  --mesh-3: hsl(200 55% 68%);
  --mesh-4: hsl(100 50% 60%);
  --shadow-glow: 0 0 60px hsl(230 60% 60% / 0.45);
  --shadow-glow-accent: 0 0 60px hsl(320 60% 68% / 0.4);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-sidebar: var(--sidebar-background);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
  --radius-sm: calc(var(--radius) - 8px);
  --radius-md: calc(var(--radius) - 4px);
  --radius-lg: var(--radius);
  --font-display: "Space Grotesk", system-ui, sans-serif;
  --font-sans: "Inter", system-ui, sans-serif;
  --font-body: "Courier Prime", "Courier New", monospace;
}

@layer base {
  * {
    border-color: var(--border);
  }
  html {
    scroll-padding-top: 4rem;
  }
  body {
    background-color: var(--background);
    color: var(--foreground);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    letter-spacing: -0.04em;
  }
  ::selection {
    background: hsl(248 90% 66% / 0.4);
    color: var(--foreground);
  }
}

@layer utilities {
  .text-gradient {
    background: linear-gradient(135deg, #fff, hsl(230 30% 75%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .text-gradient-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-glow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .text-gradient-accent {
    background: linear-gradient(135deg, var(--accent), var(--primary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .glass {
    background: hsl(230 30% 10% / 0.45);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid hsl(0 0% 100% / 0.08);
    box-shadow: var(--shadow-glass);
  }
  .glass-strong {
    /* Slightly more transparent so the pexels background reads through
       the windows a touch more — affects ALL WindowChrome instances
       (Welcome, About, Profile, Stack, Experience, Projects,
       Education, Footer) in one place. Tweak here to retune globally. */
    background: hsl(230 30% 12% / 0.6);
    backdrop-filter: blur(32px) saturate(180%);
    -webkit-backdrop-filter: blur(32px) saturate(180%);
    border: 1px solid hsl(0 0% 100% / 0.12);
  }
  .mesh-bg {
    background-color: var(--background);
    background-image:
      radial-gradient(at 18% 22%, var(--mesh-1) 0px, transparent 50%),
      radial-gradient(at 82% 12%, var(--mesh-2) 0px, transparent 50%),
      radial-gradient(at 75% 78%, var(--mesh-3) 0px, transparent 50%),
      radial-gradient(at 12% 88%, var(--mesh-4) 0px, transparent 50%);
    opacity: 0.45;
  }
  .grid-bg {
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.016) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.016) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .glow-primary { box-shadow: var(--shadow-glow); }
  .glow-accent { box-shadow: var(--shadow-glow-accent); }
  .hover-glow {
    transition: box-shadow 300ms ease, transform 300ms ease, border-color 300ms ease;
  }
  .hover-glow:hover {
    box-shadow: var(--shadow-glow);
    border-color: hsl(248 90% 66% / 0.5);
  }
  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65536' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.04;
    pointer-events: none;
  }
  .liquid-glass {
    background: hsl(248 90% 66% / 0.02);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: inset 0 1px 1px hsl(0 0% 100% / 0.08);
    position: relative;
    overflow: hidden;
  }
  .liquid-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.4px;
    background: linear-gradient(180deg,
      hsl(0 0% 100% / 0.4) 0%, hsl(0 0% 100% / 0.12) 15%, hsl(0 0% 100% / 0.02) 35%,
      hsl(0 0% 100% / 0) 50%, hsl(0 0% 100% / 0.02) 65%, hsl(0 0% 100% / 0.12) 85%,
      hsl(0 0% 100% / 0.4) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .liquid-glass-strong {
    background: hsl(248 90% 66% / 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 1px hsl(0 0% 100% / 0.12);
    position: relative;
    overflow: hidden;
  }
  .liquid-glass-strong::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.4px;
    background: linear-gradient(180deg,
      hsl(0 0% 100% / 0.45) 0%, hsl(0 0% 100% / 0.15) 15%, hsl(0 0% 100% / 0.02) 35%,
      hsl(0 0% 100% / 0) 50%, hsl(0 0% 100% / 0.02) 65%, hsl(0 0% 100% / 0.15) 85%,
      hsl(0 0% 100% / 0.45) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* CRT overlay */
  .crt-scanlines {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 60;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      hsl(0 0% 0% / 0.08) 3px,
      transparent 4px
    );
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 200ms;
  }
  .crt-on .crt-scanlines { opacity: 1; }
  .crt-vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 59;
    background: radial-gradient(ellipse at center, transparent 50%, hsl(0 0% 0% / 0.4) 100%);
    opacity: 0;
    transition: opacity 200ms;
  }
  .crt-on .crt-vignette { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .crt-scanlines, .crt-vignette { display: none; }
  }

  /* === Terminal "fog" — full-viewport backdrop blur, the panel sits on top === */
  /* z-25 keeps the fog under the dock (z-30) and the panel (z-40), so both
     stay sharp and clickable. No mask: the fog covers the entire viewport
     at very low opacity — the panel just floats over it. The blur is small
     (8px) and the tint is barely there, so it reads as a subtle, organic
     focus pull toward the terminal rather than a heavy overlay. */
  .terminal-fog {
    position: fixed;
    inset: 0;
    z-index: 25;
    pointer-events: none;
    /* Tiny horizontal smear (1.2%) so the blur reads as a directional
       "video game motion blur" rather than a symmetric gaussian halo. */
    transform: scaleX(1.012) scaleY(1);
    transform-origin: 50% 50%;
  }
  .terminal-fog-blur {
    position: absolute;
    inset: 0;
    background: hsl(230 35% 4% / 0.02);
    backdrop-filter: blur(6px) saturate(110%);
    -webkit-backdrop-filter: blur(6px) saturate(110%);
    /* Hint the compositor to pre-allocate the backdrop buffer so the
       blur is in place by the time opacity reaches 1 — kills the
       "blur appears a frame late" lag. */
    will-change: backdrop-filter, opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    .terminal-fog { transform: none; }
    .terminal-fog-blur { backdrop-filter: none; -webkit-backdrop-filter: none; }
  }

  /* === Dock item — active state glow that respects the design tokens === */
  .dock-item-active {
    background: hsl(190 95% 60% / 0.14);
    box-shadow:
      inset 0 0 0 1px hsl(190 95% 60% / 0.45),
      0 0 24px -4px hsl(190 95% 60% / 0.55);
  }
  .dock-item-active-dot {
    box-shadow: 0 0 10px hsl(190 95% 60% / 0.9), 0 0 2px hsl(190 95% 60% / 1);
  }

  /* Shared horizontal section padding — single source of truth.
     Change HERE to adjust all section margins at once:
       @media px-6 mobile  /  md:px-8  /  lg:px-10
     Components nested inside .section-px MUST NOT add their own
     horizontal padding (no px-* on inner sections). */
  .section-px {
    padding-inline: 1.5rem;          /* px-6 */
    @media (width >= 48rem) {        /* md */
      padding-inline: 2rem;          /* md:px-8 */
    }
    @media (width >= 64rem) {        /* lg */
      padding-inline: 2.5rem;        /* lg:px-10 */
    }
  }

  /* === Profile showcase (3D scroll-jack) === */
  .profile-showcase {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.5rem;
    min-height: 100vh;
    padding: 1.5rem 0;
  }
  .profile-showcase-header {
    text-align: center;
    padding: 0 1rem 1rem;
  }
  .profile-section-label {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 0.75rem;
  }
  .profile-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0 0 0.75rem;
  }
  .profile-section-intro {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    max-width: 32rem;
    margin: 0 auto;
  }

  .profile-scene {
    position: relative;
    width: 100%;
    min-height: 70vh;
    border-radius: 1.25rem;
    overflow: hidden;
    background:
      radial-gradient(at 18% 22%, hsl(248 90% 66% / 0.18) 0px, transparent 55%),
      radial-gradient(at 82% 12%, hsl(190 95% 60% / 0.12) 0px, transparent 55%),
      radial-gradient(at 75% 78%, hsl(320 85% 65% / 0.12) 0px, transparent 55%),
      hsl(230 35% 6% / 0.6);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid hsl(0 0% 100% / 0.06);
  }
  .profile-scene canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .profile-text-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .profile-text-card {
    position: absolute;
    inset: auto 0 auto 0;
    bottom: 6%;
    margin: 0 auto;
    max-width: 36rem;
    padding: 1.25rem 1.5rem;
    text-align: left;
    color: var(--foreground);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .profile-text-card.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  .profile-text-label {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .profile-text-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.6rem;
    color: var(--foreground);
  }
  .profile-text-body {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    max-width: 32rem;
  }

  .profile-scroll-hint {
    position: absolute;
    bottom: 1rem;
    right: 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
    pointer-events: none;
    animation: profile-hint-bounce 2.4s ease-in-out infinite;
  }
  @keyframes profile-hint-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(4px); opacity: 0.8; }
  }
  @media (prefers-reduced-motion: reduce) {
    .profile-scroll-hint { animation: none; }
  }

  /* === Profile mobile fallback === */
  .profile-mobile-fallback {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem 0 2.5rem;
  }
  .profile-mobile-cards-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (width >= 48rem) {
    .profile-mobile-cards-grid {
