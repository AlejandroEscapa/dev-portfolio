/* === Stripe-inspired Design System ===
   All colors MUST be HSL.
*/

@layer base {
  :root {
    /* Deep cosmic indigo background */
    --background: 230 35% 5%;
    --foreground: 210 40% 98%;

    --card: 230 30% 8%;
    --card-foreground: 210 40% 98%;

    --popover: 230 35% 7%;
    --popover-foreground: 210 40% 98%;

    /* Electric indigo */
    --primary: 248 90% 66%;
    --primary-foreground: 0 0% 100%;
    --primary-glow: 270 95% 75%;

    --secondary: 230 25% 14%;
    --secondary-foreground: 210 40% 98%;

    --muted: 230 20% 14%;
    --muted-foreground: 230 15% 65%;

    --accent: 190 95% 60%;
    --accent-foreground: 230 35% 5%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 210 40% 98%;

    --border: 230 25% 18%;
    --input: 230 25% 14%;
    --ring: 248 90% 66%;

    --radius: 1rem;

    /* Mesh gradient stops */
    --mesh-1: 248 90% 66%;
    --mesh-2: 190 95% 60%;
    --mesh-3: 320 85% 65%;
    --mesh-4: 270 95% 75%;

    --gradient-primary: linear-gradient(135deg, hsl(248 90% 66%), hsl(270 95% 75%));
    --gradient-accent: linear-gradient(135deg, hsl(190 95% 60%), hsl(248 90% 66%));
    --gradient-text: linear-gradient(135deg, hsl(0 0% 100%), hsl(230 30% 75%));

    --shadow-glow: 0 0 60px hsl(248 90% 66% / 0.45);
    --shadow-glow-accent: 0 0 60px hsl(190 95% 60% / 0.4);
    --shadow-elegant: 0 25px 60px -20px hsl(248 90% 66% / 0.35);
    --shadow-glass: 0 8px 32px hsl(230 50% 2% / 0.5);

    --sidebar-background: 230 35% 5%;
    --sidebar-foreground: 210 40% 98%;
    --sidebar-primary: 248 90% 66%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 230 25% 14%;
    --sidebar-accent-foreground: 210 40% 98%;
    --sidebar-border: 230 25% 18%;
    --sidebar-ring: 248 90% 66%;
  }
}

@layer base {
  * {
    @apply border-border;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 4rem;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-family: 'Inter', system-ui, sans-serif;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    @apply tracking-tighter;
  }

  ::selection {
    background: hsl(var(--primary) / 0.4);
    color: hsl(var(--foreground));
  }
}

@layer utilities {
  .text-gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-primary {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .glass {
    background: hsl(230 30% 10% / 0.45);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid hsl(0 0% 100% / 0.08);
    box-shadow: var(--shadow-glass);
  }

  .glass-strong {
    background: hsl(230 30% 12% / 0.7);
    backdrop-filter: blur(32px) saturate(180%);
    -webkit-backdrop-filter: blur(32px) saturate(180%);
    border: 1px solid hsl(0 0% 100% / 0.12);
  }

  .mesh-bg {
    background-color: hsl(var(--background));
    background-image:
      radial-gradient(at 18% 22%, hsl(var(--mesh-1) / 0.45) 0px, transparent 50%),
      radial-gradient(at 82% 12%, hsl(var(--mesh-2) / 0.35) 0px, transparent 50%),
      radial-gradient(at 75% 78%, hsl(var(--mesh-3) / 0.4) 0px, transparent 50%),
      radial-gradient(at 12% 88%, hsl(var(--mesh-4) / 0.4) 0px, transparent 50%);
  }

  .grid-bg {
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.016) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.016) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .glow-primary {
    box-shadow: var(--shadow-glow);
  }

  .glow-accent {
    box-shadow: var(--shadow-glow-accent);
  }

  .hover-glow {
    transition: box-shadow 300ms ease, transform 300ms ease, border-color 300ms ease;
  }

  .hover-glow:hover {
    box-shadow: var(--shadow-glow);
    border-color: hsl(var(--primary) / 0.5);
  }

  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65536' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.04;
    pointer-events: none;
  }

  .gooey-container {
    filter: blur(40px) contrast(120%);
    will-change: filter;
  }

  /* === Liquid Glass Chrome === */
  /* Nav, cards, buttons CTA - Fase 1: Cinematic Design */
  .liquid-glass {
    background: hsl(248 90% 66% / 0.02);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: inset 0 1px 1px hsl(0 0% 100% / 0.08);
    position: relative;
    overflow: hidden;
  }

  .liquid-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.4px;
    background: linear-gradient(180deg,
      hsl(0 0% 100% / 0.4) 0%,
      hsl(0 0% 100% / 0.12) 15%,
      hsl(0 0% 100% / 0.02) 35%,
      hsl(0 0% 100% / 0) 50%,
      hsl(0 0% 100% / 0.02) 65%,
      hsl(0 0% 100% / 0.12) 85%,
      hsl(0 0% 100% / 0.4) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .liquid-glass-strong {
    background: hsl(248 90% 66% / 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 1px hsl(0 0% 100% / 0.12);
    position: relative;
    overflow: hidden;
  }

  .liquid-glass-strong::before {
    content: "";
