import { useRef, useMemo } from 'react';
import { useFrame } from '@react-three/fiber';
import { useScroll } from '@react-three/drei';
import * as THREE from 'three';
import { PROFILE_PASSIONS, PASSION_META, lerpColor } from '@/lib/profile-content';

export function ProfileLights() {
  const scroll = useScroll();
  const ambientRef = useRef<THREE.AmbientLight>(null);
  const dirRef = useRef<THREE.DirectionalLight>(null);
  const pointRef = useRef<THREE.PointLight>(null);
  const rimRef = useRef<THREE.PointLight>(null);

  const setups = useMemo(
    () =>
      PROFILE_PASSIONS.map((k) => {
        const m = PASSION_META[k];
        return {
          ambient: new THREE.Color(`hsl(${m.lightColor.h}, ${m.lightColor.s}%, ${m.lightColor.l * 0.3}%)`),
          dir: new THREE.Color(`hsl(${m.lightColor.h}, ${m.lightColor.s * 0.5}%, ${m.lightColor.l}%)`),
          point: new THREE.Color(`hsl(${m.lightColor.h}, ${m.lightColor.s}%, ${m.lightColor.l}%)`),
          rim: new THREE.Color(`hsl(${(m.lightColor.h + 180) % 360}, ${m.lightColor.s}%, 50%)`),
        };
      }),
    []
  );

  const tempAmbient = useMemo(() => new THREE.Color(), []);
  const tempDir = useMemo(() => new THREE.Color(), []);
  const tempPoint = useMemo(() => new THREE.Color(), []);
  const tempRim = useMemo(() => new THREE.Color(), []);

  useFrame(() => {
    const t = scroll.offset;
    const i = Math.min(setups.length - 2, Math.floor(t * (setups.length - 1)));
    const localT = t * (setups.length - 1) - i;

    tempAmbient.copy(setups[i].ambient).lerp(setups[i + 1].ambient, localT);
    tempDir.copy(setups[i].dir).lerp(setups[i + 1].dir, localT);
    tempPoint.copy(setups[i].point).lerp(setups[i + 1].point, localT);
    tempRim.copy(setups[i].rim).lerp(setups[i + 1].rim, localT);

    if (ambientRef.current) ambientRef.current.color.copy(tempAmbient);
    if (dirRef.current) {
      dirRef.current.color.copy(tempDir);
      const orbit = t * Math.PI * 2;
      dirRef.current.position.set(Math.cos(orbit) * 4, 3, Math.sin(orbit) * 4);
    }
    if (pointRef.current) {
      pointRef.current.color.copy(tempPoint);
      pointRef.current.position.set(0, 0.5, 1.5);
    }
    if (rimRef.current) {
      rimRef.current.color.copy(tempRim);
      rimRef.current.position.set(0, -1, -2);
    }
  });

  return (
    <>
      <ambientLight ref={ambientRef} intensity={0.35} />
      <directionalLight ref={dirRef} intensity={0.7} position={[4, 3, 4]} />
      <pointLight ref={pointRef} intensity={1.4} position={[0, 0.5, 1.5]} distance={6} />
      <pointLight ref={rimRef} intensity={0.6} position={[0, -1, -2]} distance={5} />
    </>
  );
}

export const PROFILE_LIGHTS_PHASES = PROFILE_PASSIONS.map((k) => PASSION_META[k].scrollPhase);
export const PROFILE_LIGHTS_COLORS = PROFILE_PASSIONS.map((k) => {
  const m = PASSION_META[k];
  return lerpColor(m.lightColor, m.lightColor, 0);
});
