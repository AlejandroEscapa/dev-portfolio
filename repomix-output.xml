import { useRef, useMemo } from 'react';
import { useFrame } from '@react-three/fiber';
import { useScroll } from '@react-three/drei';
import { Float, RoundedBox } from '@react-three/drei';
import * as THREE from 'three';
import { useReducedMotion } from '@/hooks/useReducedMotion';
import { PROFILE_PASSIONS, PASSION_META, visibilityCurve } from '@/lib/profile-content';

interface ModelGroupProps {
  groupRef: React.MutableRefObject<THREE.Group | null>;
  emissiveColor: THREE.Color;
}

function ChefHat({ groupRef, emissiveColor }: ModelGroupProps) {
  const reduced = useReducedMotion();
  const baseColor = useMemo(() => new THREE.Color('#fafafa'), []);

  return (
    <group ref={groupRef} position={[0, 0, 0]}>
      <Float speed={reduced ? 0 : 1.1} rotationIntensity={0.15} floatIntensity={0.3}>
        <mesh position={[0, -0.55, 0]}>
          <cylinderGeometry args={[0.55, 0.6, 0.18, 32]} />
          <meshStandardMaterial
            color={baseColor}
            roughness={0.55}
            metalness={0.05}
            emissive={emissiveColor}
            emissiveIntensity={0.08}
          />
        </mesh>
        <mesh position={[0, 0.15, 0]}>
          <cylinderGeometry args={[0.5, 0.55, 1.05, 32]} />
          <meshStandardMaterial
            color={baseColor}
            roughness={0.5}
            metalness={0.05}
            emissive={emissiveColor}
            emissiveIntensity={0.1}
          />
        </mesh>
        <mesh position={[0, 0.6, 0]}>
          <sphereGeometry args={[0.4, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissiveColor} emissiveIntensity={0.06} />
        </mesh>
        <mesh position={[0, 0.78, 0]}>
          <sphereGeometry args={[0.36, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissiveColor} emissiveIntensity={0.06} />
        </mesh>
        <mesh position={[0, 0.92, 0]}>
          <sphereGeometry args={[0.3, 24, 24]} />
          <meshStandardMaterial color={baseColor} roughness={0.6} metalness={0.05} emissive={emissiveColor} emissiveIntensity={0.06} />
        </mesh>
        <pointLight position={[0, 0.5, 0.8]} color={emissiveColor} intensity={0.6} distance={2} />
      </Float>
    </group>
  );
}

function Gamepad({ groupRef, emissiveColor }: ModelGroupProps) {
  const reduced = useReducedMotion();
  const bodyColor = useMemo(() => new THREE.Color('#1a1a1f'), []);
  const accentColor = useMemo(() => new THREE.Color('#2a2a32'), []);

  return (
    <group ref={groupRef} position={[0, 0, 0]}>
      <Float speed={reduced ? 0 : 1.3} rotationIntensity={0.2} floatIntensity={0.4}>
        <RoundedBox args={[1.6, 0.45, 0.7]} radius={0.18} smoothness={6} position={[0, 0, 0]}>
          <meshStandardMaterial
            color={bodyColor}
            roughness={0.35}
            metalness={0.4}
            emissive={emissiveColor}
            emissiveIntensity={0.15}
            toneMapped={false}
          />
        </RoundedBox>
        {[
          { x: -0.55, y: -0.05 },
          { x: 0.55, y: -0.05 },
        ].map((s, i) => (
          <mesh key={i} position={[s.x, s.y, 0.36]}>
            <cylinderGeometry args={[0.13, 0.13, 0.1, 24]} />
            <meshStandardMaterial color={accentColor} roughness={0.4} metalness={0.5} emissive={emissiveColor} emissiveIntensity={0.2} toneMapped={false} />
          </mesh>
        ))}
        {[
          { x: 0.55, y: 0, z: 0.15 },
          { x: 0.7, y: 0.15, z: 0.15 },
          { x: 0.7, y: -0.15, z: 0.15 },
          { x: 0.85, y: 0, z: 0.15 },
        ].map((p, i) => (
          <mesh key={`key-${i}`} position={[p.x, p.y, p.z]}>
            <cylinderGeometry args={[0.06, 0.06, 0.04, 16]} />
            <meshStandardMaterial color="#e0e0e0" roughness={0.3} metalness={0.6} emissive={emissiveColor} emissiveIntensity={0.1} toneMapped={false} />
          </mesh>
        ))}
        {[
          { x: -0.3, y: 0.12, w: 0.18, h: 0.07 },
          { x: -0.15, y: 0.12, w: 0.18, h: 0.07 },
          { x: -0.225, y: 0.19, w: 0.07, h: 0.18 },
          { x: -0.225, y: 0.05, w: 0.07, h: 0.18 },
        ].map((p, i) => (
          <mesh key={`dpad-${i}`} position={[p.x, p.y, 0.36]}>
            <boxGeometry args={[p.w, p.h, 0.05]} />
            <meshStandardMaterial color={accentColor} roughness={0.45} metalness={0.3} />
          </mesh>
        ))}
        <pointLight position={[0, 0, 1]} color={emissiveColor} intensity={0.7} distance={2.5} />
      </Float>
    </group>
  );
}

function Keyboard({ groupRef, emissiveColor }: ModelGroupProps) {
  const reduced = useReducedMotion();
  const bodyColor = useMemo(() => new THREE.Color('#16161c'), []);
  const keyColor = useMemo(() => new THREE.Color('#e8e8ea'), []);

  const keys = useMemo(() => {
    const out: { x: number; y: number }[] = [];
    const rows = 4;
    const cols = 7;
    const startX = -0.7;
    const startY = -0.18;
    const spacingX = 1.4 / (cols - 1);
    const spacingY = 0.36 / (rows - 1);
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        out.push({ x: startX + c * spacingX, y: startY + r * spacingY });
      }
    }
    return out;
  }, []);

  return (
    <group ref={groupRef} position={[0, 0, 0]}>
      <Float speed={reduced ? 0 : 1.2} rotationIntensity={0.18} floatIntensity={0.35}>
        <RoundedBox args={[1.6, 0.6, 0.16]} radius={0.05} smoothness={4} position={[0, 0, 0]}>
          <meshStandardMaterial color={bodyColor} roughness={0.55} metalness={0.2} />
        </RoundedBox>
        {keys.map((k, i) => (
          <RoundedBox key={`key-${i}`} args={[0.14, 0.12, 0.05]} radius={0.012} smoothness={3} position={[k.x, k.y, 0.1]}>
            <meshStandardMaterial color={keyColor} roughness={0.5} metalness={0.05} emissive={emissiveColor} emissiveIntensity={0.05} />
          </RoundedBox>
        ))}
        {[
          { x: -0.55, y: 0.32 },
          { x: -0.35, y: 0.32 },
          { x: 0.35, y: 0.32 },
          { x: 0.55, y: 0.32 },
        ].map((knob, i) => (
          <group key={`knob-${i}`} position={[knob.x, knob.y, 0.1]}>
            <mesh>
              <cylinderGeometry args={[0.05, 0.05, 0.08, 24]} />
              <meshStandardMaterial color={bodyColor} roughness={0.4} metalness={0.7} emissive={emissiveColor} emissiveIntensity={0.1} toneMapped={false} />
            </mesh>
            <mesh position={[0, 0.05, 0]}>
              <cylinderGeometry args={[0.06, 0.06, 0.02, 24]} />
              <meshStandardMaterial color="#ff5555" emissive="#ff3333" emissiveIntensity={0.6} toneMapped={false} />
            </mesh>
          </group>
        ))}
        <pointLight position={[0, 0.3, 1]} color={emissiveColor} intensity={0.65} distance={2.2} />
      </Float>
    </group>
  );
}

export function ProfileModels() {
  const scroll = useScroll();
  const chefRef = useRef<THREE.Group | null>(null);
  const gameRef = useRef<THREE.Group | null>(null);
  const musicRef = useRef<THREE.Group | null>(null);
  const spinRefs = [useRef<number>(0), useRef<number>(0), useRef<number>(0)];

  const emissiveColors = useMemo(
    () =>
      PROFILE_PASSIONS.map((k) => {
        const m = PASSION_META[k];
        return new THREE.Color(`hsl(${m.emissiveColor.h}, ${m.emissiveColor.s}%, ${m.emissiveColor.l}%)`);
      }),
    []
  );

  useFrame((state, delta) => {
    const t = scroll.offset;
    const v0 = visibilityCurve(t, PASSION_META.cooking.scrollPhase);
    const v1 = visibilityCurve(t, PASSION_META.gaming.scrollPhase);
    const v2 = visibilityCurve(t, PASSION_META.music.scrollPhase);

    if (chefRef.current) {
      chefRef.current.scale.setScalar(0.001 + v0 * 1);
      chefRef.current.visible = v0 > 0.05;
      spinRefs[0].current += delta * 0.15;
      chefRef.current.rotation.y = spinRefs[0].current;
    }
    if (gameRef.current) {
      gameRef.current.scale.setScalar(0.001 + v1 * 1);
      gameRef.current.visible = v1 > 0.05;
      spinRefs[1].current += delta * 0.22;
      gameRef.current.rotation.y = spinRefs[1].current;
    }
    if (musicRef.current) {
      musicRef.current.scale.setScalar(0.001 + v2 * 1);
      musicRef.current.visible = v2 > 0.05;
      spinRefs[2].current += delta * 0.18;
      musicRef.current.rotation.y = spinRefs[2].current;
    }
  });

  return (
    <group>
      <ChefHat groupRef={chefRef} emissiveColor={emissiveColors[0]} />
      <Gamepad groupRef={gameRef} emissiveColor={emissiveColors[1]} />
      <Keyboard groupRef={musicRef} emissiveColor={emissiveColors[2]} />
    </group>
  );
}
</file>

