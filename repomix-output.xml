<file path="src/hooks/useScrollProgress.ts">
import { useEffect, useRef, useState } from 'react';

interface UseScrollProgressOptions {
  eps?: number;
}

interface ScrollProgress {
  offset: number;
  velocity: number;
  isTransitioning: boolean;
  subscribe: (cb: (t: number) => void) => () => void;
}

export function useScrollProgress({ eps = 0.0005 }: UseScrollProgressOptions = {}): ScrollProgress {
  const [offset, setOffset] = useState(0);
  const offsetRef = useRef(0);
  const subscribersRef = useRef<Set<(t: number) => void>>(new Set());

  useEffect(() => {
    const handler = () => {
      if (typeof window === 'undefined') return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const next = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (Math.abs(next - offsetRef.current) < eps) return;
      offsetRef.current = next;
      setOffset(next);
      subscribersRef.current.forEach((cb) => cb(next));
    };
    handler();
    window.addEventListener('scroll', handler, { passive: true });
    window.addEventListener('resize', handler);
    return () => {
      window.removeEventListener('scroll', handler);
      window.removeEventListener('resize', handler);
    };
  }, [eps]);

  const prevRef = useRef(0);
  const velocity = 0;
  const isTransitioning = false;

  return {
    offset,
    velocity,
    isTransitioning,
    subscribe: (cb) => {
      subscribersRef.current.add(cb);
      return () => {
        subscribersRef.current.delete(cb);
      };
    },
  };
}
</file>

