import { useRef, useMemo } from 'react';
import { useFrame, useThree } from '@react-three/fiber';
import { useScroll } from '@react-three/drei';
import * as THREE from 'three';
import { PROFILE_PASSIONS, PASSION_META } from '@/lib/profile-content';

const CAMERA_WAYPOINTS = [
  { pos: new THREE.Vector3(0, 0.5, 4.5), look: new THREE.Vector3(0, 0, 0) },
  { pos: new THREE.Vector3(3.5, -0.3, 4.0), look: new THREE.Vector3(0, 0, 0) },
  { pos: new THREE.Vector3(-2.0, 1.0, 4.5), look: new THREE.Vector3(0, 0, 0) },
  { pos: new THREE.Vector3(0, 0.5, 4.5), look: new THREE.Vector3(0, 0, 0) },
];

export function ProfileCamera() {
  const scroll = useScroll();
  const { camera } = useThree();
  const targetPos = useRef(new THREE.Vector3());
  const targetLook = useRef(new THREE.Vector3());
  const lookAt = useMemo(() => new THREE.Vector3(), []);

  const curve = useMemo(
    () => new THREE.CatmullRomCurve3(CAMERA_WAYPOINTS.map((w) => w.pos.clone()), false, 'catmullrom', 0.4),
    []
  );
  const lookCurve = useMemo(
    () => new THREE.CatmullRomCurve3(CAMERA_WAYPOINTS.map((w) => w.look.clone()), false, 'catmullrom', 0.4),
    []
  );

  useFrame(() => {
    const t = scroll.offset;
    curve.getPointAt(t, targetPos.current);
    lookCurve.getPointAt(t, targetLook.current);

    const orbit = Math.sin(t * Math.PI * 2) * 0.18;
    targetPos.current.x += orbit;
    targetPos.current.y += Math.cos(t * Math.PI * 2) * 0.12;

    camera.position.lerp(targetPos.current, 0.08);
    lookAt.lerp(targetLook.current, 0.08);
    camera.lookAt(lookAt);
  });

  return null;
}

export const PROFILE_CAMERA_DISTANCE = 4.5;
export const PROFILE_MODEL_PHASES = PROFILE_PASSIONS.map((k) => PASSION_META[k].scrollPhase);
